<div style="background-color:#1E73BE; padding:15px 25px; display:flex; align-items:center; justify-content:space-between;">
    <div style="display:flex; align-items:center;">
        <img src="/img/logo.png" style="height:45px; margin-right:15px;" />
        <span style="font-size:26px; font-weight:700; color:white;">Campus Connect</span>
    </div>

    <nav>
        @if (ViewBag.HeaderButtons != null)
        {
            foreach (var button in ViewBag.HeaderButtons)
            {
                        <a href="@button.Url" 
                           style="color:white; margin-left:20px; text-decoration:none; font-size:18px; font-weight:500;">
                    @button.Text
                        </a>
            }
        }
    </nav>
</div>
