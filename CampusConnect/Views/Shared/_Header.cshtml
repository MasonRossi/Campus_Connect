<div class="navbar">
    <div class="navbar-brand">
        <img src="/img/logo.png" alt="Campus Connect Logo" />
        <span>Campus Connect</span>
    </div>

    <nav class="navbar-links">
        @if (ViewBag.HeaderButtons != null)

        {

            <nav class="navbar-links">
                @if (ViewBag.HeaderButtons != null)
                {
                    foreach (var button in ViewBag.HeaderButtons)
                    {
                        <a asp-controller="@button.Controller"
                           asp-action="@button.Action"
                           class="nav-button">
                            @button.Text
                        </a>
                    }
                }
            </nav>

        }
    </nav>
</div>
