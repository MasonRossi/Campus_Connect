@model CampusConnect.viewModels.EventDetailViewModel

@{
    ViewData["Title"] = Model.Event.Title;
}

<div style="max-width:700px; margin:50px auto; font-family: 'Segoe UI', sans-serif;">

    <!-- Event Title -->
    <h2 style="font-weight:700; color:#1E73BE; text-align:center; margin-bottom:30px;">
        @Model.Event.Title
    </h2>

    <!-- Event Details -->
    <div style="padding:25px; border-radius:15px; border:1px solid #ccc;
                box-shadow:0 2px 5px rgba(0,0,0,0.1); background-color:white; display:flex; flex-direction:column; gap:15px;">
        <p><strong>Date:</strong> @Model.Event.Date.ToString("dddd, MMM dd, yyyy 'at' h:mm tt")</p>
        <p><strong>Location:</strong> @Model.Event.Location</p>
        <p><strong>Category:</strong> @Model.Event.Category</p>
        <p><strong>Created By:</strong> @Model.CreatorDisplayName</p>
        <p><strong>RSVP Count:</strong> @Model.Event.RSVPCount</p>

        <div style="margin-top:15px; padding:15px; border-radius:10px; border:1px solid #ccc;
                    background-color:#f9f9f9; min-height:100px;">
            @Model.Event.Description
        </div>
    </div>

    <!-- Action Button -->
    <div style="margin-top:30px; text-align:center;">
        @if (Model.CanRSVP)
        {
            <form asp-action="RSVP" method="post" style="display:inline;">
                <input type="hidden" name="EventId" value="@Model.Event.EventId" />
                <button type="submit"
                        style="padding:15px 30px; border-radius:25px; border:none; background-color:#1E73BE;
                               color:white; font-weight:600; cursor:pointer; box-shadow:0 4px 8px rgba(0,0,0,0.2);
                               transition: all 0.2s ease;">
                    @(Model.IsRSVPed ? "Cancel RSVP" : "RSVP")
                </button>
            </form>
        }
        else if (Model.CanEdit)
        {
            <a asp-controller="Home" asp-action="Create" asp-route-id="@Model.Event.EventId"
               style="padding:15px 30px; border-radius:25px; border:none; background-color:#1E73BE;
                      color:white; font-weight:600; cursor:pointer; text-decoration:none; box-shadow:0 4px 8px rgba(0,0,0,0.2);
                      transition: all 0.2s ease;">
                Edit Event
            </a>
            <!-- Delete Button -->
            <form asp-action="DeleteEvent" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this event?');">
                <input type="hidden" name="EventId" value="@Model.Event.EventId" />
                <button type="submit"
                        style="padding:15px 30px; border-radius:25px; border:none; background-color:#D9534F;
                           color:white; font-weight:600; cursor:pointer; box-shadow:0 4px 8px rgba(0,0,0,0.2);
                           transition: all 0.2s ease; margin-left:10px;">
                    Delete Event
                </button>
            </form>
        }
    </div>

</div>

<style>
    button:hover, a:hover {
        background-color: #155a9a;
        transform: translateY(-2px);
        transition: all 0.2s ease;
    }
</style>