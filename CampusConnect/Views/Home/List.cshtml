@model List<CampusConnect.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div style="max-width:900px; margin:50px auto; font-family: 'Segoe UI', sans-serif;">

    <h2 style="font-weight:700; color:#1E73BE; text-align:center; margin-bottom:20px;">
        Events
    </h2>

    <!-- Filters: search + category + location -->
    <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:15px; margin-bottom:30px;">
        <input type="text" id="searchInput" placeholder="Search events..."
               style="flex:1; min-width:200px; max-width:300px; padding:12px 20px; border-radius:25px;
                      border:1px solid #ccc; outline:none; box-shadow:0 2px 5px rgba(0,0,0,0.1);"
               onkeyup="filterEvents()" />

        <select id="categoryFilter" style="flex:1; min-width:150px; max-width:200px; padding:12px; border-radius:25px; border:1px solid #ccc; outline:none; box-shadow:0 2px 5px rgba(0,0,0,0.1);" onchange="filterEvents()">
            <option value="">All Categories</option>
            @foreach (var cat in Model.Select(e => e.Category).Distinct())
            {
                <option value="@cat">@cat</option>
            }
        </select>

        <select id="locationFilter" style="flex:1; min-width:150px; max-width:200px; padding:12px; border-radius:25px; border:1px solid #ccc; outline:none; box-shadow:0 2px 5px rgba(0,0,0,0.1);" onchange="filterEvents()">
            <option value="">All Locations</option>
            @foreach (var loc in Model.Select(e => e.Location).Distinct())
            {
                <option value="@loc">@loc</option>
            }
        </select>
    </div>

    @if (!Model.Any())
    {
        <p style="text-align:center; color:#555;">No events available.</p>
    }
    else
    {
        <div id="eventsList" style="display:flex; flex-direction:column; gap:20px;">
            @foreach (var ev in Model)
            {
                <div class="event-card" style="padding:20px; border-radius:15px; border:1px solid #ccc;
                            box-shadow:0 2px 5px rgba(0,0,0,0.1); display:flex; align-items:center;
                            justify-content:space-between; background-color:white;">

                    <div style="display:flex; flex-direction:column; gap:5px;">
                        <h3 class="event-title" style="margin:0; color:#1E73BE;">@ev.Title</h3>
                        <p style="margin:0; color:#555;"><strong>Date:</strong> @ev.Date.ToString("yyyy-MM-dd")</p>
                        <p style="margin:0; color:#555;"><strong>Location:</strong> @ev.Location</p>
                        <p style="margin:0; color:#555;"><strong>Category:</strong> @ev.Category</p>
                    </div>

                    <!-- Arrow button -->
                    <a href="@Url.Action("Detail", "Home", new { id = ev.EventId })"
                       style="display:flex; align-items:center; justify-content:center;
          width:50px; height:50px; border-radius:50%;
          background-color:#1E73BE; color:white; font-size:28px;
          font-weight:bold; text-decoration:none; box-shadow:0 4px 8px rgba(0,0,0,0.2);">
                        ➜
                    </a>

                </div>
            }
        </div>
    }
</div>

<style>
    a:hover {
        background-color: #155a9a;
        transform: translateX(3px);
        transition: all 0.2s ease;
    }

    input:focus, select:focus {
        border-color: #1E73BE;
        box-shadow: 0 0 8px rgba(30,115,190,0.3);
    }
</style>

<script>
    function filterEvents() {
        var searchInput = document.getElementById('searchInput').value.toLowerCase();
        var categoryFilter = document.getElementById('categoryFilter').value.toLowerCase();
        var locationFilter = document.getElementById('locationFilter').value.toLowerCase();

        var events = document.getElementById('eventsList').getElementsByClassName('event-card');

        for (var i = 0; i < events.length; i++) {
            var title = events[i].querySelector('.event-title').innerText.toLowerCase();
            var infoParagraphs = events[i].getElementsByTagName('p');
            var category = "";
            var location = "";

            // Loop through paragraphs to find category and location
            for (var j = 0; j < infoParagraphs.length; j++) {
                var text = infoParagraphs[j].innerText.toLowerCase();
                if (text.startsWith("category:")) {
                    category = text.replace("category:", "").trim();
                }
                if (text.startsWith("location:")) {
                    location = text.replace("location:", "").trim();
                }
            }

            var matchesSearch = title.includes(searchInput);
            var matchesCategory = categoryFilter === "" || category.includes(categoryFilter);
            var matchesLocation = locationFilter === "" || location.includes(locationFilter);

            if (matchesSearch && matchesCategory && matchesLocation) {
                events[i].style.display = "flex";
            } else {
                events[i].style.display = "none";
            }
        }
    }
</script>
