@model CampusConnect.viewModels.CreateEditEventViewModel

@{
    var isEdit = !string.IsNullOrEmpty(Model.EventId);
    ViewData["Title"] = isEdit ? "Edit Event" : "Create Event";
}

<div style="max-width:600px; margin:50px auto; font-family:'Segoe UI', sans-serif;">
    @if (!ViewData.ModelState.IsValid)
    {
        <div style="color:red; font-weight:600;">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }
    <h2 style="font-weight:700; color:#1E73BE; text-align:center; margin-bottom:30px;">
        @(isEdit ? "Edit Event" : "Create Event")
    </h2>

    <form asp-action="SaveEvent" method="post" style="display:flex; flex-direction:column; gap:15px;">

        <input type="hidden" asp-for="EventId" />

        <input asp-for="Title" placeholder="Title" required
               style="padding:12px; border-radius:25px; border:1px solid #ccc;" />

        <textarea asp-for="Description" rows="5" placeholder="Description" required
                  style="padding:12px; border-radius:15px; border:1px solid #ccc;"></textarea>

        <input asp-for="Date" type="datetime-local" required
               value="@(Model.Date != default ? Model.Date.ToString("yyyy-MM-ddTHH:mm") : "")"
               style="padding:12px; border-radius:25px; border:1px solid #ccc;" />

        <input asp-for="Category" placeholder="Category" required
               style="padding:12px; border-radius:25px; border:1px solid #ccc;" />

        <!-- Location Dropdown -->
        <select asp-for="SelectedLocationId" id="locationSelect"
                style="padding:12px; border-radius:25px; border:1px solid #ccc;"
                onchange="toggleNewLocation()">

            <option value="">-- Select Location --</option>
            <option value="NEW">Add New Location</option>

            @foreach (var loc in Model.Locations)
            {
                <option value="@loc.LocationId"
                        selected="@(Model.SelectedLocationId == loc.LocationId)">
                    @loc.Name
                </option>
            }
        </select>

        <!-- Hidden boolean that controller checks -->
        <input type="hidden" asp-for="CreateNewLocation" id="createNewLocationFlag" />

        <!-- New Location Fields -->
        <div id="newLocationFields" style="display:none; flex-direction:column; gap:10px;">

            <input asp-for="NewLocationName" placeholder="New Location Name"
                   style="padding:12px; border-radius:25px; border:1px solid #ccc;" />

            <textarea asp-for="NewLocationDescription" rows="3"
                      placeholder="Location Description"
                      style="padding:12px; border-radius:15px; border:1px solid #ccc;"></textarea>

        </div>

        <button type="submit"
                style="padding:12px; border-radius:25px; border:none;
                       background-color:#1E73BE; color:white; font-weight:600;">
            @(isEdit ? "Save Changes" : "Create Event")
        </button>
    </form>
</div>

<script>
    function toggleNewLocation() {
        var select = document.getElementById("locationSelect");
        var fields = document.getElementById("newLocationFields");
        var flag = document.getElementById("createNewLocationFlag");

        if (select.value === "NEW") {
            fields.style.display = "flex";
            flag.value = "true";
        } else {
            fields.style.display = "none";
            flag.value = "false";
        }
    }

    toggleNewLocation();
</script>