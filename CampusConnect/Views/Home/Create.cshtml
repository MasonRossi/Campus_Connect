@model CampusConnect.Models.Event

@{
    var isEdit = !string.IsNullOrEmpty(Model.EventId);
    ViewData["Title"] = isEdit ? "Edit Event" : "Create Event";
}

<div style="max-width:600px; margin:50px auto; font-family: 'Segoe UI', sans-serif;">
    <h2 style="font-weight:700; color:#1E73BE; text-align:center; margin-bottom:30px;">
        @(isEdit ? "Edit Event" : "Create Event")
    </h2>

    @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
    {
        <p style="color:red; font-weight:600;">@ViewBag.ErrorMessage</p>
    }

    <form asp-action="SaveEvent" method="post" style="display:flex; flex-direction:column; gap:15px;">

        @* Hidden EventId for edits *@
        <input type="hidden" name="EventId" value="@Model.EventId" />

        <input type="text" name="Title" placeholder="Title" value="@Model.Title"
               style="padding:12px; border-radius:25px; border:1px solid #ccc; outline:none; box-shadow:0 2px 5px rgba(0,0,0,0.1);" required />

        <textarea name="Description" placeholder="Description" rows="5"
                  style="padding:12px; border-radius:15px; border:1px solid #ccc; outline:none; box-shadow:0 2px 5px rgba(0,0,0,0.1);" required>@Model.Description</textarea>

        <input type="text" name="Location" placeholder="Campus Location" value="@Model.Location"
               style="padding:12px; border-radius:25px; border:1px solid #ccc; outline:none; box-shadow:0 2px 5px rgba(0,0,0,0.1);" required />

        <input type="datetime-local" name="Date" value="@(Model.Date != default ? Model.Date.ToString("yyyy-MM-ddTHH:mm") : "")"
               style="padding:12px; border-radius:25px; border:1px solid #ccc; outline:none; box-shadow:0 2px 5px rgba(0,0,0,0.1);" required />

        <input type="text" name="Category" placeholder="Category" value="@Model.Category"
               style="padding:12px; border-radius:25px; border:1px solid #ccc; outline:none; box-shadow:0 2px 5px rgba(0,0,0,0.1);" required />

        <button type="submit"
                style="padding:12px; border-radius:25px; border:none; background-color:#1E73BE; color:white; font-weight:600; cursor:pointer;
                       box-shadow:0 4px 8px rgba(0,0,0,0.2);">
            @(isEdit ? "Save Changes" : "Create Event")
        </button>
    </form>
</div>

<style>
    input:focus, textarea:focus {
        border-color: #1E73BE;
        box-shadow: 0 0 8px rgba(30,115,190,0.3);
    }

    button:hover {
        background-color: #155a9a;
        transform: translateY(-2px);
        transition: all 0.2s ease;
    }
</style>
