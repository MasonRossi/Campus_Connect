@model CampusConnect.viewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div style="max-width:400px; margin:50px auto; text-align:center; font-family: 'Segoe UI', sans-serif;">
    <h2 style="font-weight:700; color:#1E73BE; margin-bottom:30px;">Create Your Account</h2>

    <!-- Display general error message -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <p style="color:red; font-weight:600;">@Model.ErrorMessage</p>
    }

    <form asp-action="Register" method="post" style="display:flex; flex-direction:column; gap:15px;">
        @Html.AntiForgeryToken()

        <!-- DisplayName input + validation -->
        <span asp-validation-for="DisplayName" style="color:red; font-weight:600;"></span>
        <input asp-for="DisplayName" placeholder="Username"
               style="padding:12px; border-radius:25px; border:1px solid #ccc; outline:none;" />
        <span asp-validation-for="DisplayName" style="color:red; font-weight:600;"></span>

        <!-- Email input + validation -->
        <span asp-validation-for="Email" style="color:red; font-weight:600;"></span>
        <input asp-for="Email" placeholder="Email"
               style="padding:12px; border-radius:25px; border:1px solid #ccc; outline:none;" />

        <!-- Password input + validation -->   
        <span asp-validation-for="Password" style="color:red; font-weight:600;"></span>
        <input asp-for="Password" placeholder="Password" type="password"
               style="padding:12px; border-radius:25px; border:1px solid #ccc; outline:none;" />

        <!-- Role select + validation -->
        <span asp-validation-for="Role" style="color:red; font-weight:600;"></span>
        <select asp-for="Role"
                style="padding:12px; border-radius:25px; border:1px solid #ccc; outline:none;">
            <option value="">Select Role</option>
            <option value="Student" selected="@(Model.Role == "Student")">Student</option>
            <option value="Organizer" selected="@(Model.Role == "Organizer")">Organizer</option>
        </select>

        <button type="submit"
                style="padding:12px; border-radius:25px; border:none; background-color:#1E73BE; color:white; font-weight:600; cursor:pointer;">
            Register
        </button>
    </form>

</div>

<style>
    input:focus, select:focus {
        border-color: #1E73BE;
        box-shadow: 0 0 8px rgba(30,115,190,0.3);
    }

    button:hover {
        background-color: #155a9a;
        transform: translateY(-2px);
    }
</style>
